{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/flanksource/incident-commander/api/v1/role",
  "$ref": "#/$defs/Role",
  "$defs": {
    "BindingUnappliedRules": {
      "properties": {
        "namespace": {
          "type": "string",
          "description": "Namespace of the RoleBinding, which needn't be the role's."
        },
        "name": {
          "type": "string",
          "description": "Name of the RoleBinding."
        },
        "rules": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Rules of the role that don't apply through the binding."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "namespace",
        "name",
        "rules"
      ],
      "description": "BindingUnappliedRules is a RoleBinding whose AllRulesApply condition is False."
    },
    "Condition": {
      "properties": {
        "type": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "observedGeneration": {
          "type": "integer"
        },
        "lastTransitionTime": {
          "$ref": "#/$defs/Time"
        },
        "reason": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "type",
        "status",
        "lastTransitionTime",
        "reason",
        "message"
      ]
    },
    "FieldsV1": {
      "properties": {},
      "additionalProperties": false,
      "type": "object"
    },
    "ManagedFieldsEntry": {
      "properties": {
        "manager": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "apiVersion": {
          "type": "string"
        },
        "time": {
          "$ref": "#/$defs/Time"
        },
        "fieldsType": {
          "type": "string"
        },
        "fieldsV1": {
          "$ref": "#/$defs/FieldsV1"
        },
        "subresource": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ObjectMeta": {
      "properties": {
        "name": {
          "type": "string"
        },
        "generateName": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "selfLink": {
          "type": "string"
        },
        "uid": {
          "type": "string"
        },
        "resourceVersion": {
          "type": "string"
        },
        "generation": {
          "type": "integer"
        },
        "creationTimestamp": {
          "$ref": "#/$defs/Time"
        },
        "deletionTimestamp": {
          "$ref": "#/$defs/Time"
        },
        "deletionGracePeriodSeconds": {
          "type": "integer"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "ownerReferences": {
          "items": {
            "$ref": "#/$defs/OwnerReference"
          },
          "type": "array"
        },
        "finalizers": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "managedFields": {
          "items": {
            "$ref": "#/$defs/ManagedFieldsEntry"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "OwnerReference": {
      "properties": {
        "apiVersion": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "uid": {
          "type": "string"
        },
        "controller": {
          "type": "boolean"
        },
        "blockOwnerDeletion": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "apiVersion",
        "kind",
        "name",
        "uid"
      ]
    },
    "Role": {
      "properties": {
        "kind": {
          "type": "string"
        },
        "apiVersion": {
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/ObjectMeta"
        },
        "spec": {
          "$ref": "#/$defs/RoleSpec"
        },
        "status": {
          "$ref": "#/$defs/RoleStatus"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "description": "Role is a named set of rules, each allowing an action on the resources selected by a Scope,\noptionally on the targets selected by another Scope.\nA role grants nothing on its own: a RoleBinding grants it to subjects."
    },
    "RoleRule": {
      "properties": {
        "name": {
          "type": "string",
          "description": "Name identifies the rule within the role."
        },
        "description": {
          "type": "string",
          "description": "Description provides a brief explanation of the rule."
        },
        "action": {
          "type": "string",
          "description": "Action is the action the rule allows, e.g. read or playbook:run."
        },
        "resource": {
          "$ref": "#/$defs/ScopeReference",
          "description": "Resource is the Scope selecting the resources the action is performed on.\nOmitted for the actions that take no resource: person:manage, mcp:use, property:manage, event:read and job:read."
        },
        "target": {
          "$ref": "#/$defs/ScopeReference",
          "description": "Target is the Scope selecting what the action is performed on the resource with,\ne.g. the configs a playbook runs on. Only actions that take a target accept it.\nWithout a target, the rule only matches operations without one."
        },
        "deny": {
          "type": "boolean",
          "description": "Deny is refused: rules only allow. It's kept so that a Role setting it is rejected rather than\nstored without it, which would allow what it was written to deny. false is accepted and ignored."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "action"
      ]
    },
    "RoleSpec": {
      "properties": {
        "description": {
          "type": "string",
          "description": "Description provides a brief explanation of the role."
        },
        "rules": {
          "items": {
            "$ref": "#/$defs/RoleRule"
          },
          "type": "array",
          "description": "Rules of the role. Rules only allow."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "rules"
      ]
    },
    "RoleStatus": {
      "properties": {
        "observedGeneration": {
          "type": "integer"
        },
        "conditions": {
          "items": {
            "$ref": "#/$defs/Condition"
          },
          "type": "array"
        },
        "bindingsWithUnappliedRules": {
          "items": {
            "$ref": "#/$defs/BindingUnappliedRules"
          },
          "type": "array",
          "description": "BindingsWithUnappliedRules lists the RoleBindings of the role that some of its allow rules don't apply through,\nbecause their constraint can't narrow them. It's information, not validation: it doesn't affect whether the role is valid."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ScopeReference": {
      "properties": {
        "scopeRef": {
          "type": "string",
          "description": "ScopeRef is the Scope's name, in the namespace of the Role or RoleBinding, or namespace/name."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "scopeRef"
      ],
      "description": "ScopeReference references a Scope: by name in the namespace of the Role or RoleBinding, or as namespace/name."
    },
    "Time": {
      "properties": {},
      "additionalProperties": false,
      "type": "object"
    }
  }
}